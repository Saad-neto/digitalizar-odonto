# ======================================
# VARIÁVEIS DE AMBIENTE - DIGITALIZAR ODONTO
# ======================================

# ------------------
# SUPABASE
# ------------------
# URL do projeto Supabase (ex: https://xxxxx.supabase.co)
VITE_SUPABASE_URL=your_supabase_url_here

# Chave pública (anon key) do Supabase
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------
# ASAAS (Gateway de Pagamento Principal)
# ------------------
# API Key do Asaas (obter em: Painel Asaas → Configurações → Integrações → API)
# Sandbox: $aact_YTU5YTE0M2M2NWE3M2RiNjNlNjE3ODcwNWJjNmJkMm...
# Produção: $aact_... (sem "sandbox" no início da chave)
VITE_ASAAS_API_KEY=your_asaas_api_key_here

# Ambiente do Asaas: 'sandbox' (testes) ou 'production' (produção)
VITE_ASAAS_ENV=sandbox

# ------------------
# STRIPE (Backup/Legado)
# ------------------
# Chave pública do Stripe (modo TESTE: pk_test_... / PRODUÇÃO: pk_live_...)
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# Chave secreta do Stripe (modo TESTE: sk_test_... / PRODUÇÃO: sk_live_...)
# ⚠️ NUNCA exponha esta chave no frontend! Use apenas no backend/API
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Webhook secret do Stripe (para validar webhooks)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ------------------
# RESEND (Email)
# ------------------
# API Key do Resend (para envio de emails)
RESEND_API_KEY=your_resend_api_key_here

# Email remetente (deve estar verificado no Resend)
RESEND_FROM_EMAIL=odonto@digitalizarmkt.com.br

# Email que recebe notificações de novos pedidos
ADMIN_NOTIFICATION_EMAIL=odonto@digitalizarmkt.com.br

# ------------------
# N8N (Webhook - OPCIONAL)
# ------------------
# URL do webhook n8n (manter para backup/integração legado)
VITE_N8N_WEBHOOK_URL=https://n8n.isaai.online/webhook/odonto_form

# ------------------
# CONFIGURAÇÕES DA APLICAÇÃO
# ------------------
# URL base do site (para links em emails)
VITE_APP_URL=https://odonto.digitalizarmkt.com.br

# Modo (development ou production)
VITE_APP_MODE=development

# ------------------
# RASTREAMENTO & ANALYTICS
# ------------------
# Google Analytics 4 - Measurement ID (formato: G-XXXXXXXXXX)
# Obter em: https://analytics.google.com
VITE_GA4_MEASUREMENT_ID=

# Meta Pixel (Facebook Ads) - Pixel ID (formato: 123456789012345)
# Obter em: https://business.facebook.com/events_manager
VITE_META_PIXEL_ID=

# ------------------
# PREÇOS
# ------------------
# Valor total do site (em centavos - R$ 497,00 = 49700)
VITE_PRICE_TOTAL=49700

# Valor da entrada 50% (em centavos - R$ 248,50 = 24850)
VITE_PRICE_ENTRADA=24850

# Valor do saldo 50% (em centavos - R$ 248,50 = 24850)
VITE_PRICE_SALDO=24850
